<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Общее разрешение экосистемы: выдаётся только приложениям с тем же ключом подписи.
         Объявлено во всех приложениях экосистемы, поэтому порядок установки не важен.
         Им защищён провайдер данных задач для Крепости. -->
    <permission
        android:name="com.sonnik.ecosystem.permission.READ_DATA"
        android:label="@string/permission_read_label"
        android:description="@string/permission_read_description"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.sonnik.ecosystem.permission.READ_DATA" />

    <!-- Утренняя сводка и напоминания по времени задач. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Точное время напоминаний: на Android 13+ выдаётся приложениям-напоминалкам сразу, на 12 — в настройках. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- После перезагрузки будильник напоминаний ставится заново. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 0.26: события календаря телефона во вкладке «Календарь» — только чтение, по желанию. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Голосовое добавление: найти системное распознавание речи (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Сеть — только для синхронизации с Google Диском (включается вручную). Аналитики и рекламы нет. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Установка скачанного обновления штатным установщиком Android (без браузера и «Файлов»).
         Пользователь подтверждает установку в системном окне; на Android 8+ нужно разрешить установку
         из этого приложения в настройках — установщик сам туда направит. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pin.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- Файл людей (.zip или .vcf) из мессенджера или «Файлов»: «Открыть в Pin» → импорт с выбором. -->
            <intent-filter android:label="@string/people_import_label">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!-- Значок на рабочем столе меняется вместе с темой: свой алиас на каждую палитру,
             включён ровно один (переключает LauncherIcon при смене темы). Имена алиасов
             (.LauncherPin, .LauncherSteel, …) не переименовывать — хранятся в настройках лаунчеров.
             Иконки: @mipmap/ic_launcher — «Булавка», остальные — та же булавка на фоне палитры. -->
        <activity-alias
            android:name=".LauncherPin"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSteel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel"
            android:roundIcon="@mipmap/ic_launcher_steel"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherForest"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest"
            android:roundIcon="@mipmap/ic_launcher_forest"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSunset"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:roundIcon="@mipmap/ic_launcher_sunset"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAmethyst"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amethyst"
            android:roundIcon="@mipmap/ic_launcher_amethyst"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGraphite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherForge"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forge"
            android:roundIcon="@mipmap/ic_launcher_forge"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGarrison"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_garrison"
            android:roundIcon="@mipmap/ic_launcher_garrison"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCyber"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyber"
            android:roundIcon="@mipmap/ic_launcher_cyber"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Файл .vcf для «Поделиться людьми» — из кэша приложения, только на время отправки. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.sonnik.pin.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Быстрое добавление одной строкой — из виджета и ярлыка. -->
        <activity
            android:name=".ui.QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/quick_add"
            android:taskAffinity=""
            android:theme="@style/Theme.Pin.QuickAdd"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <!-- «Поделиться → Pin» из браузера, мессенджеров и других приложений. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Виджет «Календарь»: месяц как на вкладке «Календарь», листание месяцев, нажатие на день открывает его в Pin. -->
        <receiver
            android:name=".widget.CalendarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Сводки задач для приложений экосистемы (Крепость): только чтение, только цифры. docs/CONTRACT.md -->
        <provider
            android:name=".ecosystem.PinProvider"
            android:authorities="com.sonnik.pin.ecosystem"
            android:exported="true"
            android:readPermission="com.sonnik.ecosystem.permission.READ_DATA"
            android:writePermission="com.sonnik.ecosystem.permission.READ_DATA" />

        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".focus.FocusReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
