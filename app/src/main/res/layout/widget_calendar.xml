<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cal_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Предыдущий месяц"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/widget_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/cal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Ноябрь 2026"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Следующий месяц"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/widget_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/cal_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="Быстро добавить задачу"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cal_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/cal_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/cal_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
